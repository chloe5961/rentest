# ==============================================================================
# BERMUDA PORTAL - CLOUD GATEWAY ENVIRONMENT TEMPLATE
# ==============================================================================

# [Optional] Cloudflare API Token for automated zone and DNS synchronization
CLOUDFLARE_API_TOKEN=

# [Optional] Explicit Cloudflare Zone ID (Auto-discovered if left empty)
CLOUDFLARE_ZONE_ID=

# [Optional] Render Platform API Key for automated service and domain binding
RENDER_API_KEY=

# [Optional] Custom Domain routed through Cloudflare Edge
CUSTOM_DOMAIN=

# [Optional] Master Key Seed for deterministic credential derivation
BERMUDA_MASTER_KEY=

# [Optional] Deployment Region (frankfurt, oregon, virginia, ohio, singapore)
BERMUDA_REGION=frankfurt
